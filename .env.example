# PostgreSQL connection used by Payload's configured database adapter.
# For local development outside Docker, connect to localhost.
DATABASE_URL=postgresql://payload:YOUR_DATABASE_PASSWORD@127.0.0.1:5432/property_management
POSTGRES_USER=payload
POSTGRES_PASSWORD=YOUR_DATABASE_PASSWORD
POSTGRES_DB=property_management

# Used to encrypt JWT tokens
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Used to configure CORS, format links and more. No trailing slash
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Optional public business contact number in international format (digits only), for WhatsApp links
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Secret used to authenticate cron jobs
CRON_SECRET=YOUR_CRON_SECRET_HERE

# Used to validate preview requests
PREVIEW_SECRET=YOUR_SECRET_HERE
